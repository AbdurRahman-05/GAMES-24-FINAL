generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  fullName       String
  mobileNumber   String   @unique
  password       String
  preferredSport String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Otp {
  id           Int      @id @default(autoincrement())
  mobileNumber String
  otp          String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model AdminUser {
  id                 Int      @id @default(autoincrement())
  trackingCode       String?  @unique
  venueName          String
  ownerName          String
  ownerPhone         String
  ownerEmail         String
  streetAddress      String
  neighborhoodArea   String
  isMobileVerified   Boolean  @default(false)
  isEmailVerified    Boolean  @default(false)
  photosCount        Int      @default(0)
  photoUrls          String[] @default([])
  amenities          String[] @default([])
  gstin              String?
  panNumber          String?
  aadhaarNumber      String?
  aadhaarDocUrl      String?
  panDocUrl          String?
  gstDocUrl          String?
  bankAccount        String?
  ifscCode           String?
  upiId              String?
  status             String   @default("PENDING_APPROVAL")
  cancelReason       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VerifiedAdmin {
  id                 Int             @id @default(autoincrement())
  adminUserId        Int             @unique
  trackingCode       String?
  venueName          String
  ownerName          String
  ownerPhone         String
  ownerEmail         String
  streetAddress      String
  neighborhoodArea   String
  isMobileVerified   Boolean         @default(true)
  isEmailVerified    Boolean         @default(true)
  photosCount        Int             @default(0)
  photoUrls          String[]        @default([])
  amenities          String[]        @default([])
  gstin              String?
  panNumber          String?
  aadhaarNumber      String?
  aadhaarDocUrl      String?
  panDocUrl          String?
  gstDocUrl          String?
  bankAccount        String?
  ifscCode           String?
  upiId              String?
  status             String          @default("VERIFIED") // VERIFIED, HOLD, CANCELLED
  isBookingHold      Boolean         @default(false)
  dayRate            Float           @default(1000.0)
  nightRate          Float           @default(1400.0)
  weekdayRate        Float           @default(1200.0)
  weekendRate        Float           @default(1600.0)
  dashboard          AdminDashboard?
  bookings           TurfBooking[]
  blockedSlots       BlockedSlot[]
  offers             SlotOffer[]
  tournaments        Tournament[]
  verifiedAt         DateTime        @default(now())
  verifiedBy         String          @default("Super Admin")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model AdminDashboard {
  id                  Int           @id @default(autoincrement())
  verifiedAdminId     Int           @unique
  verifiedAdmin       VerifiedAdmin @relation(fields: [verifiedAdminId], references: [id], onDelete: Cascade)

  // Operating Schedule
  openingTime         String        @default("05:00 AM")
  closingTime         String        @default("11:00 PM")

  // Realtime Venue Performance KPIs
  todayBookingsCount  Int           @default(0)
  todayPaidBookings   Int           @default(0)
  todayCashBookings   Int           @default(0)
  todayBookingsGrowth String        @default("0% Today")
  monthRevenue        Float         @default(0.0)
  monthTotalBookings  Int           @default(0)
  revenueBadge        String        @default("₹0 GMV")
  freeSlotsCount      Int           @default(0)
  bookedSlotsCount    Int           @default(0)
  blockedSlotsCount   Int           @default(0)
  slotsBadge          String        @default("0% Full")
  cancelledTotal      Int           @default(0)
  cancelledCount      Int           @default(0)
  shiftedCount        Int           @default(0)
  cancelledBadge      String        @default("Tracked")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model TurfBooking {
  id              Int           @id @default(autoincrement())
  verifiedAdminId Int
  verifiedAdmin   VerifiedAdmin @relation(fields: [verifiedAdminId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String
  sport           String        @default("Football")
  courtName       String        @default("Main Arena")
  date            String        // "YYYY-MM-DD"
  timeSlot        String        // "06:00 AM - 07:00 AM"
  amount          Float         @default(1200.0)
  paymentMethod   String        @default("UPI")
  status          String        @default("Confirmed") // Confirmed, Cancelled, On Hold
  isHold          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BlockedSlot {
  id              Int           @id @default(autoincrement())
  verifiedAdminId Int
  verifiedAdmin   VerifiedAdmin @relation(fields: [verifiedAdminId], references: [id], onDelete: Cascade)
  date            String        // "YYYY-MM-DD"
  timeSlot        String        // "06:00 AM - 07:00 AM"
  reason          String?       @default("Blocked by Owner")
  createdAt       DateTime      @default(now())

  @@unique([verifiedAdminId, date, timeSlot])
}

model SlotOffer {
  id              Int           @id @default(autoincrement())
  verifiedAdminId Int
  verifiedAdmin   VerifiedAdmin @relation(fields: [verifiedAdminId], references: [id], onDelete: Cascade)
  date            String        // "YYYY-MM-DD"
  timeSlot        String        // "06:00 AM - 07:00 AM"
  offerType       String        // "PERCENT" or "PRICE"
  discountPercent Float?        // e.g. 20
  originalPrice   Float?        // e.g. 1000
  offerPrice      Float?        // e.g. 800
  tagLabel        String?       // e.g. "Happy Hour"
  rawOfferString  String        // e.g. "PERCENT|20|Happy Hour" or "PRICE|1000|800"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([verifiedAdminId, date, timeSlot])
}

model Tournament {
  id              Int            @id @default(autoincrement())
  verifiedAdminId Int?
  verifiedAdmin   VerifiedAdmin? @relation(fields: [verifiedAdminId], references: [id], onDelete: SetNull)
  title           String
  sport           String         @default("Football")
  format          String         @default("Knockout")
  status          String         @default("UPCOMING") // UPCOMING, LIVE, FINISHED, ON_HOLD, CANCELLED
  isHold          Boolean        @default(false)
  date            String         // "YYYY-MM-DD"
  time            String?        @default("09:00 AM")
  venueName       String
  location        String?
  entryFee        Float          @default(1500.0)
  prizePool       String?        @default("₹15,000")
  maxTeams        Int            @default(12)
  registeredTeams Int            @default(0)
  bannerUrl       String?
  organizerName   String?
  organizerPhone  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
